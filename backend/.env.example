# Spring Boot reads these as environment variables (not a .env file — Spring
# has no built-in dotenv support). Easiest ways to set them:
#   1. IntelliJ: Run > Edit Configurations > Environment variables
#   2. Terminal: export each var before `mvn spring-boot:run`
#   3. A tool like `direnv`, or the `spring-dotenv` / `EnvFile` IntelliJ plugin

# --- Required ---
DATABASE_URL=jdbc:postgresql://host:5432/dbname
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# --- Optional ---
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_EXPIRATION_MS=604800000

# Set to true once (e.g. first run) to insert demo admin/agent/customer accounts.
# Safe to leave true — it skips seeding if users already exist.
SEED_ENABLED=true

# Leave blank to log OTP codes to the console instead of sending them.
RESEND_API_KEY=
TWOFACTOR_API_KEY=
